# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요: cp .env.example .env
# .env는 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다)

# ── 프론트/백엔드팀: 로컬에 직접 설치한 MySQL을 쓰세요 ──
# (실제 운영 DB는 Cafe24 내부망 전용이라 외부에서 접속이 안 됩니다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_로컬_MySQL_비밀번호
DB_NAME=logic_web_dev
DB_SSL=false

# /admin/run-sql 엔드포인트 인증키 (로컬 개발용은 아무 값이나 넣어도 됨)
ADMIN_KEY=local-dev-key

# 로컬 서버 포트
PORT=3000
